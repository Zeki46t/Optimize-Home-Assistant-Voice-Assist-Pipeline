[Unit]
Description=Wyoming faster-whisper (GPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/wyoming-faster-whisper
# systemd does not inherit shell exports, so the CUDA 12 libraries from the venv must be set here.
Environment=LD_LIBRARY_PATH=/root/wyoming-faster-whisper/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/root/wyoming-faster-whisper/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib
# int8_float32 because Pascal GPUs are poor at float16.
# --vad-filter stops Whisper inventing words ("You") on silence.
# Do NOT add --vad-endpointing: it breaks satellite pipelines (see docs/troubleshooting.md).
ExecStart=/root/wyoming-faster-whisper/script/run \
  --model medium.en \
  --language en \
  --device cuda \
  --compute-type int8_float32 \
  --vad-filter \
  --uri tcp://0.0.0.0:10300 \
  --data-dir /var/lib/wyoming-whisper \
  --download-dir /var/lib/wyoming-whisper
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
